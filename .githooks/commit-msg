#!/bin/sh
# Enforce Conventional Commits: type(scope)!: subject
msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Allow merge/revert/fixup commits git generates itself
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|refactor|test|build|ci|perf|style)(\([a-z0-9._-]+\))?!?: .{1,72}$'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "commit-msg: first line must match Conventional Commits:" >&2
  echo "  type(scope): subject" >&2
  echo "  types: feat fix chore docs refactor test build ci perf style" >&2
  echo "  got: $first_line" >&2
  exit 1
fi
