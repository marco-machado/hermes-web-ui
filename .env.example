VITE_HERMES_HOST=127.0.0.1
VITE_HERMES_PORT=9119
# Must match the running gateway session token.
# hermes dashboard / hermes serve mint an ephemeral token unless you set
# HERMES_DASHBOARD_SESSION_TOKEN before launch. Easiest grab (loopback):
#   python3 -c "import re,urllib.request; print(re.search(r'__HERMES_SESSION_TOKEN__=\"([^\"]+)\"', urllib.request.urlopen('http://127.0.0.1:9119/').read().decode()).group(1))"
VITE_HERMES_TOKEN=
